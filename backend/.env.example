# backend/.env.example — copy to backend/.env and fill (DO NOT COMMIT)

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=30d

# Database (MySQL)
HOST=localhost
DB_PORT=3306
DATABASE=lerniq
USERNAME=your_db_user
PASSWORD=your_db_password

# Optional AMP fetch
AMPFETCHENDPOINT=https://example-amp-service.com/fetch
AMPFETCH_TOKEN=

# Optional Cloudinary (backend uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
